{
  "name": "dise-ofraude",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "npm run typecheck && npm run lint && npm run build",
    "postinstall": "node scripts/setup-vision.mjs",
    "dev:api": "cd server && .venv/Scripts/python -m uvicorn app.main:app --reload --port 8000",
    "test:api": "cd server && .venv/Scripts/python -m pytest -q"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^6.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
