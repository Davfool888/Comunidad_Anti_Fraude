# Copia este archivo como `server/.env` y completa los valores.
# `.env` está en .gitignore: nunca subas las claves al repositorio.

# --- IA ----------------------------------------------------------------------
# Motor de IA: auto | gemini | claude | local
#   auto   → Claude si hay ANTHROPIC_API_KEY, si no Gemini si hay GEMINI_API_KEY,
#            si no el motor local (reglas + enlaces; el navegador hace el OCR).
AI_PROVIDER=auto

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# El plan gratuito tiene límites por minuto y por día; al agotarse, el backend
# responde con el motor local. OJO: en el plan gratuito Google puede usar el
# contenido enviado para mejorar sus productos. No lo use con datos reales de
# víctimas fuera de la demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Respaldo si el principal está saturado, sin cuota o retirado (en orden)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Claude (Anthropic Console, de pago por uso)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (medium equilibra precisión y costo para clasificar)
ANTHROPIC_EFFORT=medium

# --- Moderación ------------------------------------------------------------
# Token de los moderadores (cabecera X-Moderator-Token). Si se deja vacío se
# genera uno al arrancar y se imprime en la consola.
MODERATOR_TOKEN=

# --- Red comunitaria -------------------------------------------------------
# true: las alertas se publican al instante como «sin verificar» y los
# moderadores las verifican o rechazan. false: quedan ocultas hasta revisión.
ALERTS_AUTO_PUBLISH=true

# --- Servidor --------------------------------------------------------------
DATABASE_PATH=data/red_segura.db
UPLOADS_DIR=data/uploads
# Orígenes permitidos (CORS), separados por comas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Peticiones por minuto y por IP a los endpoints de IA
RATE_LIMIT_PER_MINUTE=30
# Sal para seudonimizar IPs y datos reportados (cámbiala en producción)
HASH_SALT=cambia-esta-sal

# --- Transcripción de audio (opcional, requiere faster-whisper) ------------
WHISPER_MODEL=base
